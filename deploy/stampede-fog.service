[Unit]
Description=Stampede early warning fog service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/pi/StampedeDetection
ExecStart=/home/pi/StampedeDetection/.venv/bin/python -m fog.app --host 0.0.0.0 --port 8000
Restart=on-failure
User=pi

[Install]
WantedBy=multi-user.target
